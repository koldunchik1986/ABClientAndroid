<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ANClient" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnBackground">@color/colorText</item>
        <item name="android:textColorPrimary">@color/colorText</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:navigationBarColor">@color/colorSurface</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:buttonStyle">@style/Widget.ANClient.Button</item>
        <item name="buttonStyle">@style/Widget.ANClient.Button</item>
        <item name="materialButtonStyle">@style/Widget.ANClient.Button</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.ANClient.DialogButton</item>
        <item name="buttonBarButtonStyle">@style/Widget.ANClient.DialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ANClient.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ANClient.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ANClient.DialogButton</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.ANClient.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ANClient.AlertDialog</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.ANClient.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.ANClient.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.ANClient.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ThemeOverlay.ANClient.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!-- Диалоговые action-кнопки должны оставаться фиолетовыми в light/dark темах.
             Белый accent превращал OK/Отмена в белый текст на светлом transparent фоне. -->
        <item name="android:colorAccent">@color/purple_500</item>
        <item name="colorAccent">@color/purple_500</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.ANClient.DialogButton</item>
        <item name="buttonBarButtonStyle">@style/Widget.ANClient.DialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ANClient.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ANClient.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ANClient.DialogButton</item>
    </style>

    <style name="Widget.ANClient.Button" parent="Widget.MaterialComponents.Button">
        <!-- Единый вид кнопок ANClient: фиолетовый фон + белый текст независимо от темы устройства. -->
        <item name="android:background">@drawable/anclient_button_background</item>
        <item name="android:backgroundTint">@color/purple_500</item>
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/anclient_button_text</item>
        <item name="iconTint">@color/anclient_button_text</item>
    </style>

    <style name="Widget.ANClient.DialogButton" parent="Widget.AppCompat.Button">
        <!-- AlertDialog по умолчанию делает text-button без фона; задаём реальный фон,
             чтобы OK/Отмена не терялись на светлой поверхности. -->
        <item name="android:background">@drawable/anclient_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/anclient_button_text</item>
        <item name="android:textColorLink">@color/anclient_button_text</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
