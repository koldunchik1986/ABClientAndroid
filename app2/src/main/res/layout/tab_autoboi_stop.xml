<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/an_autoboi_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/checkDoStopNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Остановить немедленно"
            android:layout_marginBottom="12dp" />

        <CheckBox
            android:id="@+id/checkDoStopLowHp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Остановить при низком HP ≤:" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <SeekBar
                android:id="@+id/seekStopLowHp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/tvStopLowHp"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0%" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/checkDoStopLowMa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Остановить при низкой MA ≤:" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <SeekBar
                android:id="@+id/seekStopLowMa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/tvStopLowMa"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0%" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/checkDoExit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выйти из боя"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkDoExitRisky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выйти при опасном противнике (человек / ftype≥80)"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сообщение о нападении:"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/radioGroupSayByGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioSayNoByGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Не отправлять" />

            <RadioButton
                android:id="@+id/radioSayChatByGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="В общий чат" />

            <RadioButton
                android:id="@+id/radioSayClanByGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="В клан" />

            <RadioButton
                android:id="@+id/radioSayPairByGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Приватом" />

        </RadioGroup>

    </LinearLayout>

</ScrollView>
