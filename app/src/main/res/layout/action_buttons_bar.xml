<?xml version="1.0" encoding="utf-8"?>
<!-- Панель кнопок действий для вспомогательных вкладок -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/action_buttons_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/tab_button_bar_background"
    android:padding="8dp"
    android:gravity="center">

    <ImageButton
        android:id="@+id/action_button_1"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:contentDescription="Кнопка 1" />

    <ImageButton
        android:id="@+id/action_button_2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:contentDescription="Кнопка 2" />

    <ImageButton
        android:id="@+id/action_button_3"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:contentDescription="Кнопка 3" />

    <ImageButton
        android:id="@+id/action_button_4"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:contentDescription="Кнопка 4" />

</LinearLayout>
