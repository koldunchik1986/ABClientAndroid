}

function trans(txt)
{
      var strarr = txt.split(' ');
      var reg = /(\w+):\/\/([^/:]+)(:\d*)?([^# ]*)/;
      var m;
      
      for(m=0; m<strarr.length; m++)
      {
            if(!reg.test(strarr[m]) && strarr[m].indexOf("Re:") < 0 && strarr[m].indexOf("neverlands.ru") < 0) strarr[m] = convert(strarr[m]);
      }
      return strarr.join(' ');
}

